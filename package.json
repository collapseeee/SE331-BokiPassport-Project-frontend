    "axios": "^1.19.0",
    "json-server": "^1.0.0-beta.15",
    "media-icons": "^1.1.5",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-router": "4.5.0",
